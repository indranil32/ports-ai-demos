# Copy to .env and fill in. Never commit .env.

# Required — your Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Forces every prototype onto one model. The original artifacts used a mix of
# claude-sonnet-5 and claude-sonnet-4-6; leave blank to keep what each one asks for.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — set to put the whole site behind a shared password (HTTP Basic auth,
# any username). Strongly recommended before sharing a public URL.
DEMO_PASSWORD=

# Optional tuning
PORT=8787
RATE_LIMIT_PER_MIN=60
MAX_TOKENS_CAP=4000
